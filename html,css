<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sunnyside</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@600&family=Fraunces:ital,opsz,wght@0,9..144,700;0,9..144,900;1,9..144,700;1,9..144,900&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Fraunces", serif;

        margin: 0;
      }
      #top {
        background-image: url("https://github.com/munkhdorj-m/2025-11th-Web-Exercise-2/blob/main/images/image-header.jpg?raw=true");
        background-size: cover;
        background-position: center;
        height: 756px;
      }
      #navbar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        background-color: transparent;
        color: white;
        gap: 10px;
        padding: 0 43px;
      }
      #links {
        display: flex;
        gap: 40px;
        padding: 0 35px;
      }
      #btn {
        background-color: white;
        color: black;
        border-radius: 46px;
        border: none;
        height: 43px;
        width: 120px;
        cursor: pointer;
        align-items: center;
        font-weight: 700;
        font-family: "Fraunces", serif;
      }
      #title {
        display: flex;
        align-items: center;
        font-size: 2.2em;
        font-weight: bold;
        margin-right: auto;
      }
      #hero {
        background-color: transparent;
        font-size: 2.7em;
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        word-spacing: 22px;
      }
      #first {
        display: flex;
      }
      #first div {
        box-sizing: border-box;
        padding: 0 52px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      #first h1 {
        font-size: 2.3em;
      }
      #first p {
        font-size: 16px;
        font-weight: lighter;
        color: grey;
      }
      #first button {
        align-self: flex-start;
        border: 0;
        padding: 0 4px;
        background: linear-gradient(transparent 55%, #ffe783 55%);
        font: inherit;
        font-size: 17px;
        font-weight: 700;
      }
      #second {
        display: flex;
      }
      #second div {
        box-sizing: border-box;
        padding: 0 52px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      #second h1 {
        font-size: 2.3em;
      }
      #second p {
        font-size: 16px;
        font-weight: lighter;
        color: grey;
      }
      #second button {
        align-self: flex-start;
        border: 0;
        padding: 0 4px;
        background: linear-gradient(transparent 55%, #ff6f7b 55%);
        font: inherit;
        font-size: 17px;
        font-weight: 700;
      }
      #third {
        display: flex;
        position: relative;
      }
      #third img {
        display: block;
      }
      #third div {
        position: absolute;
        bottom: 28px;
        width: 50%;
        box-sizing: border-box;
        padding: 0 40px;
        text-align: center;
      }
      #txt1 p {
        font-weight: 200;
      }
      #txt2 p {
        font-weight: 200;
      }
      #txt2 {
        right: 0;
      }
    </style>
  </head>
  <body>
    <div id="top">
      <div id="navbar">
        <div id="title">
          <p>Sunnyside</p>
        </div>
        <div id="links">
          <p>About</p>
          <p>Services</p>
          <p>Projects</p>
        </div>
        <button id="btn">CONTACT</button>
      </div>
      <div id="hero">
        <h1>WE ARE CREATIVES</h1>
      </div>
    </div>
    <div id="first">
      <div style="width: 50%">
        <h1>Transform your brand</h1>
        <p>
          We are a full-service creative agency specializing in helping brands
          grow fast. Engage your clients through compelling visuals that do most
          of the marketing for you.
        </p>
        <button>LEARN MORE</button>
      </div>
      <img
        width="50%"
        src="https://github.com/munkhdorj-m/2025-11th-Web-Exercise-2/blob/main/images/image-transform.jpg?raw=true"
        alt=""
      />
    </div>
    <div id="second">
      <img
        width="50%"
        src="https://github.com/munkhdorj-m/2025-11th-Web-Exercise-2/blob/main/images/image-stand-out.jpg?raw=true"
        alt=""
      />
      <div style="width: 50%">
        <h1>Stand out to the right audience</h1>
        <p>
          Using a collaborative formula of designers, researchers,
          photographers, videographers, and copywriters, we'll build and extend
          your brand in digital places.
        </p>
        <button>LEARN MORE</button>
      </div>
    </div>
    <div id="third">
      <img
        width="50%"
        src="https://github.com/munkhdorj-m/2025-11th-Web-Exercise-2/blob/main/images/image-graphic-design.jpg?raw=true"
        alt=""
      />
      <img
        id="img2"
        width="50%"
        src="https://github.com/munkhdorj-m/2025-11th-Web-Exercise-2/blob/main/images/image-photography.jpg?raw=true"
        alt=""
      />
      <div id="txt1">
        <h1>Graphic Design</h1>
        <p>
          Great design makes you memorable. We deliver artwork that underscores
          your brand message and captures potential clients' attention.
        </p>
      </div>
      <div id="txt2">
        <h1>Photography</h1>
        <p>
          Increase your credibility by getting the most stunning, high- quality
          photos that improve your business image.
        </p>
      </div>
    </div>
  </body>
</html>
